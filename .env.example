# Copy to .env and adjust. docker-compose reads these automatically.

# qBittorrent Web UI connection
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# A heartbeat tag stays "active" until this many seconds pass with no ping.
# Clients should ping well within this window (e.g. every 60s for 180s).
HEARTBEAT_TIMEOUT=180

# How often the watchdog expires stale heartbeats and reconciles qBittorrent.
POLL_INTERVAL=15

# Where flag state is persisted (keep this on a mounted volume).
STATE_FILE=/data/state.json

LOG_LEVEL=INFO
