# Reference for the environment variables Pausarr reads. Pass these to the
# container with `docker run -e VAR=value ...`, an `--env-file`, or your own
# Compose stack's `environment:` block.

# qBittorrent Web UI connection
QBITTORRENT_URL=http://qbittorrent:8080

# Username/password are OPTIONAL. Leave them unset (or empty) if qBittorrent is
# configured to bypass authentication for Pausarr's IP/subnet. Set both only if
# your qBittorrent Web UI requires a login.
#QBITTORRENT_USER=admin
#QBITTORRENT_PASS=adminadmin

# A heartbeat tag stays "active" until this many seconds pass with no ping.
# Clients should ping well within this window (e.g. every 60s for 180s).
HEARTBEAT_TIMEOUT=180

# How often the watchdog expires stale heartbeats and reconciles qBittorrent.
POLL_INTERVAL=15

# What a pause does: all | keep-seeding. OPTIONAL — there is no default.
#   all          - fully stop/start every torrent (the classic behaviour).
#   keep-seeding - stop downloading but keep completed torrents seeding. Pausarr
#                  sets qBittorrent's global max_active_downloads to 0 (enabling
#                  queueing if needed) while paused, then restores the original
#                  values on resume.
#
# Two ways to choose the mode:
#   1. Set PAUSE_MODE here. It becomes the single, fixed mode used for every
#      pause and OVERRIDES any per-request pause_mode.
#   2. Leave it unset. Then each caller MUST send a "pause_mode" in its request
#      body (see the API section of the README). This lets different callers
#      use different modes: if several are active at once, the MOST RESTRICTIVE
#      wins ("all" beats "keep-seeding"). A pause request with no pause_mode and
#      no global PAUSE_MODE is rejected with HTTP 400.
#PAUSE_MODE=all

# keep-seeding crash-recovery fallback. Normally Pausarr restores your real
# max_active_downloads on resume. But if it ever reads a value of 0 (downloads
# already stopped — e.g. it crashed while paused and lost its saved snapshot),
# the real value is unknown, so it restores this instead. Set it to match your
# normal qBittorrent max_active_downloads. Default 100000 = effectively
# unlimited (qBittorrent's own sentinel). Only used in keep-seeding mode.
KEEP_SEEDING_MAX_ACTIVE_DOWNLOADS=100000

# Where flag state is persisted (keep this on a mounted volume).
STATE_FILE=/data/state.json

LOG_LEVEL=INFO
